{
  "version": 2,
  "name": "veyra-bot",
  "builds": [
    {
      "src": "web/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "web/public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "web/server.js"
    }
  ]
}
